{
  "name": "eslint-config-scratch",
  "version": "15.0.0-next.1",
  "description": "Shareable ESLint config for Scratch",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "husky",
    "format": "eslint --fix && prettier --write .",
    "test:lint": "eslint && prettier --check .",
    "test:types": "tsc",
    "test:vitest": "vitest run",
    "test": "npm run test:lint && npm run test:types && npm run test:vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scratchfoundation/eslint-config-scratch.git"
  },
  "author": "Massachusetts Institute of Technology",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/scratchfoundation/eslint-config-scratch/issues"
  },
  "homepage": "https://github.com/scratchfoundation/eslint-config-scratch#readme",
  "keywords": [
    "eslint",
    "eslintconfig",
    "prettier",
    "scratch"
  ],
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@eslint/markdown": "8.0.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-formatjs": "8.1.2",
    "eslint-plugin-html": "8.2.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "scratch-semantic-release-config": "4.0.2",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "files": [
    "lib/",
    "TRADEMARK"
  ],
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
